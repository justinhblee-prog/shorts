# Copy to .env and replace every value with a strong secret.
# Prefer individual operator tokens; each token must be 32+ characters.
# When set, this JSON replaces the legacy shared NEXUS_REVIEW_TOKEN.
NEXUS_REVIEW_CREDENTIALS_JSON=
# Required when per-operator credentials are configured; assign only necessary roles.
# Example: {"alice":["reviewer"],"bob":["publisher"],"carol":["analyst","finance"]}
NEXUS_REVIEW_ROLE_MAP_JSON=
# Legacy single-operator migration fallback only. Generate a 32+ character random secret.
# Leave empty when using NEXUS_REVIEW_CREDENTIALS_JSON.
NEXUS_REVIEW_TOKEN=
# API rate limits per minute; trusted proxies are opt-in and must be explicit CIDRs.
NEXUS_API_RATE_LIMIT_PER_MINUTE=120
NEXUS_API_AUTH_RATE_LIMIT_PER_MINUTE=20
NEXUS_API_PUBLISH_RATE_LIMIT_PER_MINUTE=10
NEXUS_API_CONTROL_RATE_LIMIT_PER_MINUTE=30
NEXUS_API_REVIEW_RATE_LIMIT_PER_MINUTE=60
NEXUS_API_PRODUCTION_RATE_LIMIT_PER_MINUTE=30
NEXUS_TRUSTED_PROXY_CIDRS=

NEXUS_DB_PATH=/app/data/nexus.sqlite3
NEXUS_MEDIA_DIR=/app/data/media
NEXUS_MAX_MEDIA_BYTES=268435456
NEXUS_UPLOAD_STALE_SECONDS=900
# Comma-separated exact HTTPS artifact hostnames supplied by your renderer provider.
# Required to stage renderer output and run ffprobe byte-level QA before human review.
RENDER_ARTIFACT_HOSTS=
NEXUS_LEASE_SECONDS=300
NEXUS_HEARTBEAT_SECONDS=10
NEXUS_SCHEDULER_POLL_SECONDS=30
NEXUS_SCHEDULER_LEASE_SECONDS=90
NEXUS_IDLE_SECONDS=3

# Provider adapter endpoints must implement the JSON contracts in backend/README.md.
SCRIPT_PROVIDER_URL=
SCRIPT_PROVIDER_TOKEN=
VOICE_PROVIDER_URL=
VOICE_PROVIDER_TOKEN=
# Optional independent ASR provider; when configured, transcribes generated narration
# and compares it with the script. Must return JSON: {"transcript":"...","provider":"..."}.
# This sends the generated audio URL to the configured transcription service.
TRANSCRIPTION_PROVIDER_URL=
TRANSCRIPTION_PROVIDER_TOKEN=
RENDER_PROVIDER_URL=
RENDER_PROVIDER_TOKEN=

# YouTube OAuth refresh-token credentials; never commit actual secrets.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# OAuth callback must be registered exactly in Google Cloud Console
YOUTUBE_REDIRECT_URI=https://your-domain.example/api/youtube/oauth/callback
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Optional legacy fallback; encrypted OAuth storage is preferred
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DATA_API_KEY=

# TikTok Login Kit OAuth (confidential web client). Enable Content Posting API and video.publish/video.list scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/oauth/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable and back up securely; losing it makes stored OAuth tokens undecryptable.
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Optional static-token fallback; OAuth with token rotation is preferred.
TIKTOK_ACCESS_TOKEN=

# YouTube Analytics refresh cadence (default 24 hours); collector lease auto-renews during long batches.
YOUTUBE_ANALYTICS_MIN_AGE_SECONDS=86400
YOUTUBE_ANALYTICS_LEASE_SECONDS=900

# Automatic SQLite + media backup (Compose backup service)
NEXUS_BACKUP_RETENTION_DAYS=14
NEXUS_BACKUP_INTERVAL_SECONDS=86400
# Optional AES-256-GCM encryption for the complete SQLite + media archive.
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Store this key separately from backup files; losing it makes encrypted backups unrecoverable.
NEXUS_BACKUP_ENCRYPTION_KEY=
# Set true to refuse plaintext backup creation and restoration.
NEXUS_BACKUP_ENCRYPTION_REQUIRED=false

# Optional ClamAV malware scanning for renderer artifacts. Disabled by default.
# Start the updater profile with: docker compose --profile media-scan up -d
NEXUS_MEDIA_SCAN_ENABLED=false
NEXUS_CLAMSCAN_PATH=clamscan
NEXUS_CLAMAV_DATABASE_DIR=/var/lib/clamav
NEXUS_MEDIA_SCAN_TIMEOUT_SECONDS=120
